POSTGRES_DB=sekurity
POSTGRES_USER=sekurity
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKEND_INTERNAL_TOKEN=replace-with-another-long-random-token
BACKEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
CERTBOT_HOST_DIR=/etc/letsencrypt
SITE_URL=https://sekurity.kr

DISCORD_TOKEN=replace-with-the-discord-bot-token
DISCORD_CLIENT_ID=replace-with-the-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-the-discord-oauth-client-secret
DISCORD_REDIRECT_URI=https://sekurity.kr/api/v1/auth/discord/callback
DISCORD_GUILD_ID=1507335622719967292
DISCORD_TEST_USER_ID=
WEB_AUTH_GUILD_ID=1507335622719967292
WEB_ACTIVE_MEMBER_ROLE_ID=1507362589619912734
WEB_BOARD_MEMBER_ROLE_ID=1507362663339135047

# Generate each value independently with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-a-different-32-character-random-value

# Container-internal private storage; do not set this to a host web root.
UPLOAD_DIR=/app/data/profile-photos
UPLOAD_MAX_BYTES=5242880
